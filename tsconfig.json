{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@repo/database": ["packages/database/index.ts"],
      "@repo/api-client": ["packages/api-client/index.ts"],
      "@repo/ui/*": ["packages/ui/*"],
      "@repo/utils": ["packages/utils/index.ts"]
    }
  }
}
